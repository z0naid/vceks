# Keep the build context small and, more importantly, stop host artifacts from
# shadowing what the builder stage generates. Copying a host node_modules or
# .next into the image produces confusing failures that look like source bugs.

node_modules
.next
.git
.gitignore

# Local environment files must never be baked into an image. Configuration
# arrives at runtime from the ECS task definition.
.env
.env.*
!.env.example

# Docker's own files
Dockerfile
.dockerignore
docker-compose*.yml

# Docs and editor noise
README.md
AGENTS.md
*.md
.vscode
.idea
.DS_Store
*.log

# Tests are type-checked during `next build` but are not part of the runtime
# image. They stay in the repo, out of the container.
**/*.test.ts
**/*.test.tsx
vitest.config.mts
